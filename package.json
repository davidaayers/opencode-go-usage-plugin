{
  "name": "@davidaayers/opencode-go-usage-plugin",
  "version": "0.1.4",
  "packageManager": "pnpm@10.33.0",
  "description": "OpenCode TUI plugin: OpenCode Go plan usage (5h/weekly/monthly) from the official usage API",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui-plugin",
    "opencode-go",
    "usage",
    "quota"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidaayers/opencode-go-usage-plugin.git"
  },
  "bugs": "https://github.com/davidaayers/opencode-go-usage-plugin/issues",
  "homepage": "https://github.com/davidaayers/opencode-go-usage-plugin#readme",
  "scripts": {
    "build": "bun build.mjs",
    "prepack": "bun build.mjs",
    "typecheck": "pnpm exec tsc --noEmit",
    "test:pack": "bun test --conditions=browser packed-install.test.mjs",
    "check": "pnpm typecheck && pnpm test:pack"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.3",
    "@opencode/theme": "2.1.3",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/node": "^24.10.1",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.2"
  }
}
