{
  "name": "@davidaayers/opencode-go-usage-plugin",
  "version": "0.1.2",
  "packageManager": "pnpm@10.33.0",
  "description": "OpenCode TUI plugin: OpenCode Go plan usage (5h/weekly/monthly) from the official usage API",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./tui": "./src/go-usage.tsx"
  },
  "files": [
    "src/go-usage.tsx"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui-plugin",
    "opencode-go",
    "usage",
    "quota"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidaayers/opencode-go-usage-plugin.git"
  },
  "bugs": "https://github.com/davidaayers/opencode-go-usage-plugin/issues",
  "homepage": "https://github.com/davidaayers/opencode-go-usage-plugin#readme",
  "scripts": {
    "typecheck": "pnpm exec tsc --noEmit",
    "check": "pnpm typecheck"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.21",
    "@opencode-ai/sdk": "^1.18.21",
    "@opentui/core": "^0.5.6",
    "@opentui/solid": "^0.5.6",
    "@types/node": "^24.10.1",
    "solid-js": "^1.9.9",
    "typescript": "^5.9.2"
  }
}
